<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>28a9b8b6-d9fd-4c69-85f5-1a9f7f2d1dce</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>main.py</StartupFile>
    <SearchPath>
    </SearchPath>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <Name>pdf_fitting_project</Name>
    <RootNamespace>pdf_fitting_project</RootNamespace>
    <InterpreterId>Global|VisualStudio|Scripts</InterpreterId>
    <TestFramework>Pytest</TestFramework>
    <IsWindowsApplication>False</IsWindowsApplication>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="pdf_fitting\fit_engine.py" />
    <Compile Include="pdf_fitting\gui\app.py" />
    <Compile Include="pdf_fitting\gui\builder.py" />
    <Compile Include="pdf_fitting\gui\cif_utils.py" />
    <Compile Include="pdf_fitting\gui\defaults.py" />
    <Compile Include="pdf_fitting\gui\main.py" />
    <Compile Include="pdf_fitting\gui\mainwindow.py" />
    <Compile Include="pdf_fitting\gui\param_widgets.py" />
    <Compile Include="pdf_fitting\gui\plots.py" />
    <Compile Include="pdf_fitting\gui\structure_view.py" />
    <Compile Include="pdf_fitting\gui\tooltips.py" />
    <Compile Include="pdf_fitting\gui\worker.py" />
    <Compile Include="pdf_fitting\gui\__init__.py" />
    <Compile Include="pdf_fitting\gui\__main__.py" />
    <Compile Include="pdf_fitting\io_handler.py" />
    <Compile Include="pdf_fitting\models\broadening.py" />
    <Compile Include="pdf_fitting\models\gr_model.py" />
    <Compile Include="pdf_fitting\models\microstrain_utils.py" />
    <Compile Include="pdf_fitting\models\numba_kernels.py" />
    <Compile Include="pdf_fitting\models\shape_factor.py" />
    <Compile Include="pdf_fitting\models\__init__.py" />
    <Compile Include="pdf_fitting\structure_handler.py" />
    <Compile Include="pdf_fitting\utils.py" />
    <Compile Include="pdf_fitting\__init__.py" />
    <Compile Include="main.py" />
    <Compile Include="test.py" />
  </ItemGroup>
  <ItemGroup>
    <Interpreter Include="env\">
      <Id>env</Id>
      <Version>3.9</Version>
      <Description>env (Python 3.9 (64-bit))</Description>
      <InterpreterPath>$(ProjectDir)env\Scripts\python.exe</InterpreterPath>
      <WindowsInterpreterPath>Scripts\pythonw.exe</WindowsInterpreterPath>
      <PathEnvironmentVariable>PYTHONPATH</PathEnvironmentVariable>
      <Architecture>X64</Architecture>
    </Interpreter>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="config\" />
    <Folder Include="data\" />
    <Folder Include="pdf_fitting\" />
    <Folder Include="output\" />
    <Folder Include="pdf_fitting\models\" />
    <Folder Include="pdf_fitting\gui\" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="config\input.inp" />
    <Content Include="data\FeCr_ID31.xy" />
    <Content Include="data\Fe_bcc_300K.cif" />
    <Content Include="output\log.output" />
  </ItemGroup>
  <ItemGroup>
    <InterpreterReference Include="CondaEnv|CondaEnv|env" />
    <InterpreterReference Include="Global|VisualStudio|Scripts" />
    <InterpreterReference Include="MSBuild|env|$(MSBuildProjectFullPath)" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
  <!-- Uncomment the CoreCompile target to enable the Build command in
       Visual Studio and specify your pre- and post-build commands in
       the BeforeBuild and AfterBuild targets below. -->
  <!--<Target Name="CoreCompile" />-->
  <Target Name="BeforeBuild">
  </Target>
  <Target Name="AfterBuild">
  </Target>
</Project>